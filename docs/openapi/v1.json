                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignMemberRolesRequest": {
        "required": [
          "roles"
        ],
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleAssignmentInput"
            }
          }
        }
      },
      "AssignmentResponse": {
        "required": [
          "roleId",
          "scope",
          "scopeRefId"
        ],
        "type": "object",
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "$ref": "#/components/schemas/DataScope"
          },
          "scopeRefId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "ConfirmEmailRequest": {
        "required": [
          "userId",
          "token"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "ConfirmTotpRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "CreateOrganizationRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "DataScope": {
        "enum": [
          "own",
          "team",
          "practiceArea",
          "branch",
          "organization"
        ],
        "description": "Escopo de dados de uma atribuição de perfil (seção 7.2)."
      },
      "ForgotPasswordRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "JobResponse": {
        "required": [
          "id",
          "type",
          "status",
          "resultLocation",
          "errorCode",
          "createdAt",
          "startedAt",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "resultLocation": {
            "type": [
              "null",
              "string"
            ]
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Estado de uma operação longa para `GET /api/v1/jobs/{id}` (seção 4.4)."
      },
      "MemberResponse": {
        "required": [
          "id",
          "userId",
          "joinedAt",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssignmentResponse"
            }
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "email",
          "fullName",
          "emailConfirmed",
          "mfaMethod",
          "createdAt",
          "lastLoginAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "mfaMethod": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastLoginAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Perfil do usuário logado. `mfaMethod`: `none`, `totp` ou `email`."
      },
      "MfaPolicyRequest": {
        "required": [
          "mfaRequired"
        ],
