            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/organization/members": {
      "get": {
        "tags": [
          "Organization"
        ],
        "summary": "Membros da organização ativa e os perfis de cada um",
