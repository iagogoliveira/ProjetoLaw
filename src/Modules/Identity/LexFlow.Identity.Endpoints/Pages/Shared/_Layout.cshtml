<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>@ViewData["Title"] · LexFlow</title>
    <style>
        :root { color-scheme: light dark; --fg: #1f2933; --bg: #f4f5f7; --card: #ffffff; --muted: #52606d; --accent: #1d4ed8; --danger: #b91c1c; --border: #cbd2d9; }
        @@media (prefers-color-scheme: dark) { :root { --fg: #e4e7eb; --bg: #111827; --card: #1f2937; --muted: #9aa5b1; --accent: #93b4ff; --danger: #fca5a5; --border: #3e4c59; } }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, sans-serif; }
        main { width: 100%; max-width: 420px; background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 32px; }
        .brand { margin: 0 0 8px; font-weight: 700; font-size: 20px; }
        h1 { margin: 0 0 24px; font-size: 24px; }
        label { display: block; margin: 16px 0 4px; font-weight: 600; }
        input { width: 100%; padding: 10px 12px; font: inherit; color: inherit; background: transparent; border: 1px solid var(--border); border-radius: 6px; }
        input:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
        button { margin-top: 24px; width: 100%; padding: 12px; font: inherit; font-weight: 600; color: #fff; background: #1d4ed8; border: 0; border-radius: 6px; cursor: pointer; }
        .hint { color: var(--muted); font-size: 14px; margin: 4px 0 0; }
        .error { color: var(--danger); }
        .links { margin-top: 24px; display: flex; flex-direction: column; gap: 8px; }
        a { color: var(--accent); }
    </style>
</head>
<body>
    <main>
        <p class="brand">LexFlow</p>
        @RenderBody()
    </main>
</body>
</html>
