<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <title>{{ subject | html.escape }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;">
    <tr>
      <td style="padding:32px;font-size:16px;line-height:1.5;">
        <p style="margin:0 0 24px;font-size:20px;font-weight:bold;">LexFlow</p>
{{ content }}
        <p style="margin:32px 0 0;font-size:13px;color:#616e7c;">Este é um e-mail automático. Não responda a esta mensagem.</p>
      </td>
    </tr>
  </table>
</body>
</html>
