<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>lexflow-apphost</UserSecretsId>
    <!-- DCP/dashboard via pacotes NuGet: dispensa o Aspire CLI no dev e no CI (ADR 0004). -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Host\LexFlow.Api\LexFlow.Api.csproj" />
    <ProjectReference Include="..\..\Host\LexFlow.Worker\LexFlow.Worker.csproj" />
  </ItemGroup>
</Project>
